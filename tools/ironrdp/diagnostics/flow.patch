+// Isolated diagnostics build only. No hook is installed by the normal client.
+// The cached JS callback timestamps every event in the session Worker's clock
+// domain; no payload, URL, account or protocol bytes cross this boundary.
+struct FlowTrace {
+    callback: Option<js_sys::Function>,
+    serial: u32,
+}
+impl FlowTrace {
+    fn new() -> Self {
+        let callback = js_sys::Reflect::get(&js_sys::global(), &"unitermRdpFlowTrace".into())
+            .ok().and_then(|value| value.dyn_into::<js_sys::Function>().ok());
+        Self { callback, serial: 0 }
+    }
+    fn next_loop(&mut self) -> u32 {
+        if self.callback.is_some() { self.serial = self.serial.wrapping_add(1); }
+        self.serial
+    }
+    fn enabled(&self) -> bool { self.callback.is_some() }
+    fn record(&self, stage: u32, id: u32, a: usize, b: usize, c: usize) {
+        if let Some(callback) = &self.callback {
+            // Browser/WASM lengths fit u32; saturate unexpected diagnostic values.
+            let number = |value| JsValue::from(u32::try_from(value).unwrap_or(u32::MAX));
+            let _ = callback.call5(&JsValue::UNDEFINED, &stage.into(), &id.into(),
+                &number(a), &number(b), &number(c));
+        }
+    }
+}
