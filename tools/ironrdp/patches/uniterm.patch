@@ -0,0 +1,75 @@
+//! GPU handler keeps native YUV through presentation. Only Alpha's rare CPU
+//! read-modify-write path requests a readback; normal video does not.
+use ironrdp_egfx::client::{BitmapUpdate, GraphicsPipelineHandler, Surface};
+use ironrdp_egfx::decode::Yuv420Frame;
+use ironrdp_egfx::avc444::Yuv444Frame;
+use ironrdp_egfx::pdu::*;
+use ironrdp_pdu::geometry::ExclusiveRectangle;
+use wasm_bindgen::{JsCast, JsValue};
+
+pub(crate) struct WebGraphicsHandler;
+fn release_avc(surface: u16) {
+    #[cfg(target_arch = "wasm32")]
+    if let Ok(function) = js_sys::Reflect::get(&js_sys::global(), &"unitermReleaseAvc".into()) {
+        if let Ok(function) = function.dyn_into::<js_sys::Function>() {
+            let _ = function.call1(&JsValue::UNDEFINED, &surface.into());
+        }
+    }
+    #[cfg(not(target_arch = "wasm32"))]
+    let _ = surface;
+}
+fn command(name: &str, args: impl FnOnce() -> js_sys::Array) -> Option<JsValue> {
+    let global=js_sys::global();
+    let function=js_sys::Reflect::get(&global,&"unitermGpuCommand".into()).ok()?.dyn_into::<js_sys::Function>().ok()?;
+    let all=js_sys::Array::new();all.push(&name.into());for arg in args().iter(){all.push(&arg);}
+    function.apply(&global,&all).ok()
+}
+macro_rules! call {
+    ($name:expr $(,$value:expr)* $(,)?) => {{
+        #[cfg(target_arch="wasm32")]
+        { command($name, || { let args=js_sys::Array::new();$(args.push(&JsValue::from($value));)* args }) }
+        #[cfg(not(target_arch="wasm32"))]
+        { None::<JsValue> }
+    }};
+}
+fn rect(r:&ExclusiveRectangle)->js_sys::Array {
+    [r.left,r.top,r.right,r.bottom].into_iter().map(JsValue::from).collect()
+}
+fn rects(rs:&[ExclusiveRectangle])->js_sys::Array { rs.iter().map(|r|JsValue::from(rect(r))).collect() }
+fn points(ps:&[Point])->js_sys::Array { ps.iter().map(|p|JsValue::from([p.x,p.y].into_iter().map(JsValue::from).collect::<js_sys::Array>())).collect() }
+fn planes(y:&[u8],u:&[u8],v:&[u8])->[js_sys::Uint8Array;3] { [y,u,v].map(js_sys::Uint8Array::from) }
+impl GraphicsPipelineHandler for WebGraphicsHandler {
+    fn externally_composited(&self)->bool {call!("active").and_then(|v|v.as_bool()).unwrap_or(false)}
+    fn on_reset_graphics(&mut self,width:u32,height:u32){call!("reset",width,height);}
+    fn on_surface_created(&mut self,s:&Surface){release_avc(s.id);call!("create",s.id,s.width,s.height);}
+    fn on_surface_deleted(&mut self,id:u16){release_avc(id);call!("remove",id);}
+    fn on_surface_mapped(&mut self,id:u16,x:u32,y:u32){call!("map",id,x,y);}
+    fn on_map_surface_to_scaled_output(&mut self,p:&MapSurfaceToScaledOutputPdu){call!("map",p.surface_id,p.output_origin_x,p.output_origin_y,p.target_width,p.target_height);}
+    fn on_bitmap_updated(&mut self,p:&BitmapUpdate){call!("bitmap",p.surface_id,rect(&p.destination_rectangle),js_sys::Uint8Array::from(p.data.as_slice()));}
+    fn on_frame_complete(&mut self,_id:u32){call!("frame");}
+    fn on_close(&mut self){call!("close");}
+    fn on_solid_fill(&mut self,p:&SolidFillPdu){let c=&p.fill_pixel;call!("fill",p.surface_id,[c.r,c.g,c.b,255].into_iter().map(JsValue::from).collect::<js_sys::Array>(),rects(&p.rectangles));}
+    fn on_surface_to_surface(&mut self,p:&SurfaceToSurfacePdu){call!("copy",p.source_surface_id,p.destination_surface_id,rect(&p.source_rectangle),points(&p.destination_points));}
+    fn on_surface_to_cache(&mut self,p:&SurfaceToCachePdu){call!("store",p.surface_id,p.cache_slot,rect(&p.source_rectangle));}
+    fn on_cache_to_surface(&mut self,p:&CacheToSurfacePdu){call!("restore",p.cache_slot,p.surface_id,points(&p.destination_points));}
+    fn on_evict_cache_entry(&mut self,p:&EvictCacheEntryPdu){call!("evict",p.cache_slot);}
+    fn read_surface(&mut self,id:u16)->Option<Vec<u8>> {let result=call!("readSurface",id)?;result.is_instance_of::<js_sys::Uint8Array>().then(||js_sys::Uint8Array::new(&result).to_vec())}
+    fn on_yuv420(&mut self,id:u16,p:&Yuv420Frame,dest:&ExclusiveRectangle,regions:&[ExclusiveRectangle])->bool {
+        if !self.externally_composited(){return false;}
+        let (y,u,v,ys,cs)=p.planes();
+        if ys!=usize::from(p.width()) || cs!=usize::from(p.width().div_ceil(2)){return false;}
+        let [y,u,v]=planes(y,u,v);
+        let areas=js_sys::Array::new();
+        if regions.is_empty(){let area=rect(dest);area.push(&0.into());area.push(&0.into());areas.push(&area);}
+        else {for r in regions {
+            let r=ExclusiveRectangle {left:r.left,top:r.top,right:r.right.min(p.width()),bottom:r.bottom.min(p.height())};
+            if r.left<r.right && r.top<r.bottom{areas.push(&rect(&r));}
+        }}
+        call!("yuvBitmap",id,0u32,p.width(),p.height(),y,u,v,areas).and_then(|v|v.as_bool()).unwrap_or(false)
+    }
+    fn on_yuv444(&mut self,id:u16,p:&Yuv444Frame,regions:&[ExclusiveRectangle])->bool {
+        if !self.externally_composited(){return false;}
+        let (y,u,v,stride,rows)=p.planes();let [y,u,v]=planes(y,u,v);
+        call!("yuvBitmap",id,1u32,stride as u32,rows as u32,y,u,v,rects(regions)).and_then(|v|v.as_bool()).unwrap_or(false)
+    }
+}
