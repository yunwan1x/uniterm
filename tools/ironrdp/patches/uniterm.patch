new file mode 100644
index 00000000..f31c6687
--- /dev/null
+++ b/crates/ironrdp-web/src/webcodecs.rs
@@ -0,0 +1,64 @@
+//! The JS bridge runs only in a dedicated worker. Its nested WebCodecs worker
+//! completes one picture before waking this synchronous protocol decoder.
+use ironrdp_egfx::decode::{DecodedFrame, DecoderError, DecoderResult, H264Decoder, Yuv420Frame};
+use wasm_bindgen::{JsCast, JsValue};
+
+struct WebDecoder {
+    surface: u16,
+    yuv: bool,
+}
+fn invoke(name: &str, args: &js_sys::Array) -> Result<JsValue, JsValue> {
+    let global = js_sys::global();
+    js_sys::Reflect::get(&global, &name.into())?
+        .dyn_into::<js_sys::Function>()?
+        .apply(&global, args)
+}
+pub(crate) fn decoder() -> Option<Box<dyn H264Decoder>> {
+    #[cfg(target_arch = "wasm32")]
+    if js_sys::Reflect::get(&js_sys::global(), &"unitermDecodeAvc".into()).is_ok_and(|v| v.is_function()) {
+        let yuv = js_sys::Reflect::get(&js_sys::global(), &"unitermAvcYuv".into()).ok().and_then(|v| v.as_bool()).unwrap_or(false);
+        return Some(Box::new(WebDecoder { surface: 0, yuv }));
+    }
+    None
+}
+impl H264Decoder for WebDecoder {
+    fn select_surface(&mut self, surface_id: u16) {
+        self.surface = surface_id;
+    }
+    fn decode(&mut self, data: &[u8]) -> DecoderResult<DecodedFrame> {
+        let args = js_sys::Array::new();
+        args.push(&self.surface.into());
+        args.push(&js_sys::Uint8Array::from(data));
+        let result = invoke("unitermDecodeAvc", &args).map_err(|_| DecoderError::msg("WebCodecs AVC decode failed"))?;
+        let a = js_sys::Array::from(&result);
+        let width = a.get(0).as_f64().unwrap_or_default() as u32;
+        let height = a.get(1).as_f64().unwrap_or_default() as u32;
+        let pixels = js_sys::Uint8Array::new(&a.get(2)).to_vec();
+        if width == 0 || height == 0 || u64::from(width) * u64::from(height) * 4 != pixels.len() as u64 {
+            return Err(DecoderError::msg("Invalid WebCodecs frame extent"));
+        }
+        Ok(DecodedFrame::new(pixels, width, height))
+    }
+    fn supports_yuv420(&self) -> bool { self.yuv }
+    fn decode_yuv420(&mut self, data: &[u8]) -> DecoderResult<Yuv420Frame> {
+        let args = js_sys::Array::new();
+        args.push(&self.surface.into());
+        args.push(&js_sys::Uint8Array::from(data));
+        args.push(&JsValue::TRUE);
+        let result = invoke("unitermDecodeAvc", &args).map_err(|_| DecoderError::msg("WebCodecs YUV decode failed"))?;
+        let a = js_sys::Array::from(&result);
+        let width = a.get(0).as_f64().unwrap_or_default();
+        let height = a.get(1).as_f64().unwrap_or_default();
+        if width < 1.0 || height < 1.0 || width > 8192.0 || height > 8192.0 || width.fract() != 0.0 || height.fract() != 0.0 {
+            return Err(DecoderError::msg("Invalid WebCodecs YUV extent"));
+        }
+        let (width, height) = (width as u16, height as u16);
+        Yuv420Frame::new(width, height,
+            js_sys::Uint8Array::new(&a.get(2)).to_vec(), usize::from(width),
+            js_sys::Uint8Array::new(&a.get(3)).to_vec(),
+            js_sys::Uint8Array::new(&a.get(4)).to_vec(), usize::from(width.div_ceil(2)))
+    }
+    fn reset(&mut self) {
+        let _ = invoke("unitermResetAvc", &js_sys::Array::new());
+    }
+}
