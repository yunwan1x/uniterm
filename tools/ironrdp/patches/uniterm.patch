@@ -0,0 +1,103 @@
+//! Drain buffered network traffic before graphics without a timer per command.
+//! A receive budget forces graphics progress during continuous network traffic.
+use std::future::poll_fn;
+use std::task::Poll;
+
+pub(crate) enum Work<T> {
+    Network(T),
+    Graphics,
+}
+
+#[derive(Default)]
+pub(crate) struct ReceiveBudget {
+    milliseconds: f64,
+    pdus: usize,
+}
+
+impl ReceiveBudget {
+    pub(crate) fn received(&mut self, milliseconds: f64) {
+        self.milliseconds += milliseconds.max(0.0);
+        self.pdus = self.pdus.saturating_add(1);
+    }
+
+    pub(crate) fn graphics_processed(&mut self) {
+        *self = Self::default();
+    }
+
+    pub(crate) fn prioritize_graphics(&self, pending_count: usize, pending_bytes: usize) -> bool {
+        self.milliseconds >= 4.0 || self.pdus >= 32 || pending_count >= 512 || pending_bytes >= 16 * 1024 * 1024
+    }
+}
+
+pub(crate) async fn next_work<T>(
+    network: impl Future<Output = T>,
+    graphics_ready: bool,
+    prioritize_graphics: bool,
+) -> Work<T> {
+    futures_util::pin_mut!(network);
+    poll_fn(move |cx| {
+        if graphics_ready && prioritize_graphics {
+            return Poll::Ready(Work::Graphics);
+        }
+        if let Poll::Ready(frame) = network.as_mut().poll(cx) {
+            return Poll::Ready(Work::Network(frame));
+        }
+        if graphics_ready { Poll::Ready(Work::Graphics) } else { Poll::Pending }
+    }).await
+}
+
+#[cfg(test)]
+mod tests {
+    use futures_util::{FutureExt as _, future};
+    use super::*;
+
+    // oracle: regression 2026-11-15 router RDP frame drops during scrolling and playback.
+    #[test]
+    fn idle_network_does_not_delay_ready_graphics() {
+        // This must complete on the first poll: no browser timer or further
+        // network packet should be necessary to process an idle final EndFrame.
+        assert!(matches!(next_work(future::pending::<()>(), true, false).now_or_never(), Some(Work::Graphics)));
+    }
+
+    // oracle: mutant graphics starving already buffered audio.
+    #[test]
+    fn buffered_network_and_audio_are_received_before_normal_graphics() {
+        assert!(matches!(next_work(future::ready(41), true, false).now_or_never(), Some(Work::Network(41))));
+    }
+
+    // oracle: mutant unbounded receive traffic starving graphics.
+    #[test]
+    fn exhausted_budget_services_graphics_before_ready_network() {
+        let network = future::poll_fn::<(), _>(|_| panic!("network must not be polled ahead of urgent graphics"));
+        assert!(matches!(next_work(network, true, true).now_or_never(), Some(Work::Graphics)));
+    }
+
+    // oracle: mutant a pending decode blocking network reception.
+    #[test]
+    fn pending_decode_does_not_prevent_network_progress() {
+        assert!(matches!(next_work(future::ready(42), false, true).now_or_never(), Some(Work::Network(42))));
+        assert!(next_work(future::pending::<()>(), false, true).now_or_never().is_none());
+    }
+
+    // oracle: mutant clock rounding allowing unlimited receives without graphics progress.
+    #[test]
+    fn coarse_clocks_cannot_starve_graphics_and_processing_resets_budget() {
+        let mut budget = ReceiveBudget::default();
+        for _ in 0..31 { budget.received(0.0); }
+        assert!(!budget.prioritize_graphics(1, 1));
+        budget.received(0.0);
+        assert!(budget.prioritize_graphics(1, 1));
+        budget.graphics_processed();
+        assert!(!budget.prioritize_graphics(1, 1));
+        budget.received(4.0);
+        assert!(budget.prioritize_graphics(1, 1));
+    }
+
+    // oracle: mutant queue growth failing to trigger graphics progress.
+    #[test]
+    fn queue_high_water_marks_force_progress_without_waiting_for_clock_budget() {
+        let budget = ReceiveBudget::default();
+        assert!(budget.prioritize_graphics(512, 1));
+        assert!(budget.prioritize_graphics(1, 16 * 1024 * 1024));
+    }
+}
