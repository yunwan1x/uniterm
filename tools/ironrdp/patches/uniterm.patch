@@ -754,3 +754,88 @@ fn a_decoder_without_yuv_planes_advertises_no_avc444() {
         ]
     );
 }
+
+/// A cropped 3x3 picture whose final chroma block extends into the coded padding.
+/// The auxiliary view is packed from MS-RDPEGFX 3.3.8.3.2 B4 to B7, without using `split`.
+fn fixed_chroma_picture() -> Yuv444Frame {
+    const U: [[u8; 4]; 4] = [
+        [128, 107, 128, 118],
+        [118, 130, 135, 100],
+        [128, 120, 128, 118],
+        [110, 125, 118, 117],
+    ];
+    const V: [[u8; 4]; 4] = [
+        [128, 135, 128, 135],
+        [138, 140, 125, 153],
+        [128, 133, 128, 139],
+        [140, 142, 138, 138],
+    ];
+    let main = Yuv420Frame::new(16, 16, vec![100; 256], 16, vec![128; 64], vec![128; 64], 8)
+        .expect("main view");
+    let (mut y, mut u, mut v) = (vec![128; 256], vec![128; 64], vec![128; 64]);
+    for row in 0..2 {
+        // B4 and B5 carry the odd chroma rows in the auxiliary luma plane.
+        y[row * 16..row * 16 + 4].copy_from_slice(&U[2 * row + 1]);
+        y[(row + 8) * 16..(row + 8) * 16 + 4].copy_from_slice(&V[2 * row + 1]);
+        // B6 and B7 carry the odd columns of the even chroma rows.
+        for col in 0..2 {
+            u[row * 8 + col] = U[2 * row][2 * col + 1];
+            v[row * 8 + col] = V[2 * row][2 * col + 1];
+        }
+    }
+    let auxiliary = Yuv420Frame::new(16, 16, y, 16, u, v, 8).expect("auxiliary view");
+    let rect = ExclusiveRectangle {
+        left: 0,
+        top: 0,
+        right: 3,
+        bottom: 3,
+    };
+    let mut picture = Yuv444Frame::new(3, 3);
+    picture.apply_main_view(&main, core::slice::from_ref(&rect));
+    picture.apply_auxiliary_view(Avc444Layout::V1, &auxiliary, core::slice::from_ref(&rect));
+    picture
+}
+
+// oracle: spec MS-RDPEGFX §3.3.8.3.1
+// oracle: spec MS-RDPEGFX §3.3.8.3.2
+#[test]
+fn an_odd_crop_keeps_absolute_chroma_parity_and_padded_neighbours() {
+    let picture = fixed_chroma_picture();
+    let rect = ExclusiveRectangle {
+        left: 1,
+        top: 1,
+        right: 3,
+        bottom: 3,
+    };
+    // The first three pixels use (U,V)=(130,140), (135,125), (120,133).
+    // At (2,2), padded neighbours recover U=4*128-118-118-117=159 and
+    // V=4*128-139-138-138=97; neither reconstruction may stop at the crop edge.
+    // With Y=100, the specification's inverse matrix gives these exact RGBA bytes.
+    assert_eq!(
+        picture.to_rgba(&rect),
+        [118, 94, 103, 255, 95, 100, 112, 255, 107, 99, 85, 255, 51, 108, 157, 255],
+    );
+}
+
+// oracle: spec MS-RDPEGFX §3.3.8.3.1
+// oracle: spec MS-RDPEGFX §3.3.8.3.2
+#[rstest]
+#[case::neither_component(0, 0, [100, 100, 100, 255])]
+#[case::u_only(2, 0, [100, 94, 157, 255])]
+#[case::v_only(0, 2, [51, 114, 100, 255])]
+fn reverse_chroma_cutoff_is_applied_independently_to_u_and_v(
+    #[case] left: u16,
+    #[case] top: u16,
+    #[case] expected: [u8; 4],
+) {
+    let picture = fixed_chroma_picture();
+    // U/V reconstructions differ from 128 by (29,29), (31,29), and (29,31).
+    // Only the components that differ by 31 are used in the inverse color matrix.
+    let rect = ExclusiveRectangle {
+        left,
+        top,
+        right: left + 1,
+        bottom: top + 1,
+    };
+    assert_eq!(picture.to_rgba(&rect), expected, "pixel ({left}, {top})");
+}
