+    /// Pending deferred graphics commands, independently of incoming network PDUs.
+    pub fn pending_graphics_work(&self) -> (usize, usize) {
+        self.get_dvc::<GraphicsPipelineClient>()
+            .map(|gfx| gfx.processor().pending_work()).unwrap_or_default()
+    }
+
+    /// Execute one ordered graphics command, returning its actual completion ACK
+    /// and framebuffer damage. The receiver can service RDPSND between commands.
+    pub fn process_pending_graphics(&mut self, image: &mut DecodedImage) -> SessionResult<Vec<ActiveStageOutput>> {
+        let Some(mut gfx) = self.get_dvc_mut::<GraphicsPipelineClient>() else { return Ok(Vec::new()) };
+        let channel_id = gfx.channel_id();
+        let replies = gfx.processor_mut().process_pending().map_err(SessionError::pdu)?;
+        let mut outputs = Vec::new();
+        if !replies.is_empty() {
+            let messages = ironrdp_dvc::encode_dvc_messages(channel_id, replies, ironrdp_svc::ChannelFlags::empty())
+                .map_err(SessionError::encode)?;
+            let frame = self.encode_dvc_messages(messages)?;
+            outputs.push(ActiveStageOutput::ResponseFrame(frame));
+        }
+        let (region, windows) = self.drain_graphics_pipeline(image)?;
+        if let Some(region) = region { outputs.push(ActiveStageOutput::GraphicsUpdate(region)); }
+        if !windows.is_empty() { outputs.push(ActiveStageOutput::WindowSurfaceUpdates(windows)); }
+        self.widen_to_full_refresh(image, &mut outputs);
+        Ok(outputs)
+    }
+
     /// Drains the client-side EGFX compositor: follows a pending `ResetGraphics`, composites
     /// each completed-frame output region into `image` and records its damage.
     ///
