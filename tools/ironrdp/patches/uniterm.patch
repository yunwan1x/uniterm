diff --git a/crates/ironrdp-web/src/capture.rs b/crates/ironrdp-web/src/capture.rs
new file mode 100644
index 00000000..e63e5444
--- /dev/null
+++ b/crates/ironrdp-web/src/capture.rs
@@ -0,0 +1,348 @@
+//! Browser capture adapters. No device is advertised unless explicitly enabled by JS.
+use crate::session::RdpInputEvent;
+use futures_channel::mpsc;
+use ironrdp::dvc::DrdynvcClient;
+use ironrdp_rdpeai::{
+    AudioFormat, WaveFormat,
+    client::{AudioPacketSink, RdpeaiCaptureHandler, RdpeaiClient},
+};
+use ironrdp_rdpecam::{
+    CameraBackend, CameraRedirectionSession, DeviceDescriptor, ErrorCode, MediaFormat, MediaType, SampleSink,
+    StartStreamInfo, StreamDescription,
+};
+use ironrdp_svc::SvcMessage;
+use std::sync::{
+    Arc, Mutex,
+    atomic::{AtomicUsize, Ordering},
+};
+
+#[derive(Default)]
+pub(crate) struct Microphone {
+    format: Option<AudioFormat>,
+    packet_size: usize,
+    pending: Vec<u8>,
+    sink: Option<AudioPacketSink>,
+    epoch: u32,
+}
+impl Microphone {
+    pub(crate) fn status(&self) -> Vec<u32> {
+        self.format
+            .as_ref()
+            .map(|f| vec![f.n_samples_per_sec, u32::from(f.n_channels), self.epoch])
+            .unwrap_or_default()
+    }
+    pub(crate) fn submit(&mut self, data: &[u8]) {
+        if self.sink.is_none() || self.packet_size == 0 || data.len() > 65536 || data.len() % 2 != 0 {
+            return;
+        }
+        self.pending.extend_from_slice(data);
+        while self.pending.len() >= self.packet_size {
+            let packet: Vec<_> = self.pending.drain(..self.packet_size).collect();
+            if let Some(sink) = &mut self.sink {
+                sink(packet);
+            }
+        }
+    }
+}
+fn supported(f: &AudioFormat) -> bool {
+    f.format == WaveFormat::PCM
+        && f.bits_per_sample == 16
+        && matches!(f.n_channels, 1 | 2)
+        && (8000..=48000).contains(&f.n_samples_per_sec)
+        && f.n_block_align == f.n_channels * 2
+}
+struct BrowserMic(Arc<Mutex<Microphone>>);
+impl RdpeaiCaptureHandler for BrowserMic {
+    fn supported_formats(&self) -> &[AudioFormat] {
+        &[]
+    }
+    fn choose_formats(&self, offered: &[AudioFormat]) -> Vec<AudioFormat> {
+        offered.iter().filter(|f| supported(f)).cloned().collect()
+    }
+    fn open(&mut self, capture: &AudioFormat, encoding: &AudioFormat, size: usize, sink: AudioPacketSink) -> i32 {
+        if !supported(capture)
+            || !supported(encoding)
+            || size == 0
+            || size > 65536
+            || size % usize::from(encoding.n_block_align) != 0
+        {
+            return -2147467259;
+        }
+        let mut m = self.0.lock().unwrap();
+        m.epoch = m.epoch.wrapping_add(1);
+        m.format = Some(encoding.clone());
+        m.packet_size = size;
+        m.pending.clear();
+        m.sink = Some(sink);
+        0
+    }
+    fn set_format(&mut self, f: &AudioFormat, size: usize) -> bool {
+        if !supported(f) || size == 0 || size > 65536 || size % usize::from(f.n_block_align) != 0 {
+            return false;
+        }
+        let mut m = self.0.lock().unwrap();
+        m.epoch = m.epoch.wrapping_add(1);
+        m.format = Some(f.clone());
+        m.packet_size = size;
+        m.pending.clear();
+        true
+    }
+    fn close(&mut self) {
+        let mut m = self.0.lock().unwrap();
+        m.format = None;
+        m.sink = None;
+        m.pending.clear();
+    }
+}
+#[derive(Default)]
+pub(crate) struct Camera {
+    sink: Option<SampleSink>,
+    epoch: u32,
+}
+impl Camera {
+    pub(crate) fn requested(&self) -> u32 {
+        self.sink
+            .as_ref()
+            .filter(|s| s.is_active() && s.pending_requests(0) > 0)
+            .map(|_| self.epoch)
+            .unwrap_or(0)
+    }
+    pub(crate) fn submit(&self, epoch: u32, jpeg: Vec<u8>) {
+        if epoch != self.epoch
+            || jpeg.len() > 512 * 1024
+            || !jpeg.starts_with(&[0xff, 0xd8])
+            || !jpeg.ends_with(&[0xff, 0xd9])
+        {
+            return;
+        }
+        if let Some(sink) = &self.sink {
+            sink.send_sample(0, jpeg);
+        }
+    }
+}
+fn camera_format() -> MediaType {
+    MediaType::new(MediaFormat::Mjpg, 640, 480, 10, 1, 1, 1, MediaType::DECODING_REQUIRED).expect("fixed camera format")
+}
+struct BrowserCamera(Arc<Mutex<Camera>>);
+impl CameraBackend for BrowserCamera {
+    fn activate(&mut self) -> Result<(), ErrorCode> {
+        Ok(())
+    }
+    fn deactivate(&mut self) -> Result<(), ErrorCode> {
+        self.stop_streams()
+    }
+    fn streams(&mut self) -> Result<Vec<StreamDescription>, ErrorCode> {
+        Ok(vec![StreamDescription::color(true, false)])
+    }
+    fn media_types(&mut self, index: u8) -> Result<Vec<MediaType>, ErrorCode> {
+        if index != 0 {
+            return Err(ErrorCode::InvalidStreamNumber);
+        }
+        Ok(vec![camera_format()])
+    }
+    fn current_media_type(&mut self, index: u8) -> Result<MediaType, ErrorCode> {
+        self.media_types(index).map(|x| x[0])
+    }
+    fn start_streams(&mut self, streams: &[StartStreamInfo], sink: SampleSink) -> Result<(), ErrorCode> {
+        if streams.len() != 1 || streams[0].stream_index != 0 || streams[0].media_type != camera_format() {
+            return Err(ErrorCode::InvalidMediaType);
+        }
+        let mut c = self.0.lock().unwrap();
+        c.epoch = c.epoch.wrapping_add(1).max(1);
+        c.sink = Some(sink);
+        Ok(())
+    }
+    fn stop_streams(&mut self) -> Result<(), ErrorCode> {
+        self.0.lock().unwrap().sink = None;
+        Ok(())
+    }
+    fn shutdown(&mut self) {
+        let _ = self.stop_streams();
+    }
+}
+#[derive(Clone, Default)]
+pub(crate) struct Capture {
+    pub(crate) microphone: Arc<Mutex<Microphone>>,
+    pub(crate) camera: Arc<Mutex<Camera>>,
+}
+#[derive(Debug)]
+pub(crate) struct CaptureMessages {
+    pub(crate) messages: Mutex<Vec<SvcMessage>>,
+    queued: Arc<AtomicUsize>,
+}
+impl Drop for CaptureMessages {
+    fn drop(&mut self) {
+        self.queued.fetch_sub(1, Ordering::Relaxed);
+    }
+}
+impl Capture {
+    pub(crate) fn attach(
+        &self,
+        mut dvc: DrdynvcClient,
+        tx: mpsc::UnboundedSender<RdpInputEvent>,
+        mic: bool,
+        camera: bool,
+    ) -> DrdynvcClient {
+        let queued = Arc::new(AtomicUsize::new(0));
+        let send = move |_id: u32, messages: Vec<SvcMessage>| {
+            if queued
+                .fetch_update(Ordering::Relaxed, Ordering::Relaxed, |n| (n < 8).then_some(n + 1))
+                .is_ok()
+            {
+                let _ = tx.unbounded_send(RdpInputEvent::Capture(CaptureMessages {
+                    messages: Mutex::new(messages),
+                    queued: queued.clone(),
+                }));
+            }
+            Ok(())
+        };
+        if mic {
+            dvc = dvc.with_dynamic_channel(RdpeaiClient::new(
+                Box::new(BrowserMic(self.microphone.clone())),
+                Box::new(send.clone()),
+            ));
+        }
+        if camera {
+            let session = CameraRedirectionSession::new();
+            let device = session
+                .select_device(
+                    DeviceDescriptor::new("uniTerm Browser Camera".into(), "RDCamera_Browser_0".into())
+                        .expect("camera descriptor"),
+                )
+                .expect("camera device");
+            let state = self.camera.clone();
+            let listener = device.listener(move || Some(BrowserCamera(state.clone())), Arc::new(send));
+            dvc = dvc
+                .with_listener(listener)
+                .with_dynamic_channel(session.enumeration_client(vec![device]).expect("camera enumeration"));
+        }
+        dvc
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use ironrdp::dvc::DvcProcessor;
+    use ironrdp_core::{decode, encode_vec};
+    use ironrdp_rdpeai::pdu::{FormatsPdu, OpenPdu, RdpeaiPdu, Version, VersionPdu, pcm_format};
+    use ironrdp_rdpecam::pdu::{DeviceMessage, DevicePdu, EnumerationPdu};
+    use ironrdp_rdpecam::{DeviceClient, ProtocolVersion};
+
+    #[test]
+    fn microphone_negotiates_and_packetizes_then_stops_on_channel_close() {
+        let state = Arc::new(Mutex::new(Microphone::default()));
+        let packets = Arc::new(Mutex::new(Vec::new()));
+        let output = packets.clone();
+        let mut client = RdpeaiClient::new(
+            Box::new(BrowserMic(state.clone())),
+            Box::new(move |_, messages| {
+                output.lock().unwrap().extend(messages);
+                Ok(())
+            }),
+        );
+        client.start(7).unwrap();
+        let fmt = pcm_format(1, 16000, 16);
+        for pdu in [
+            RdpeaiPdu::Version(VersionPdu::new(Version::V1)),
+            RdpeaiPdu::Formats(FormatsPdu::server(vec![fmt.clone()])),
+            RdpeaiPdu::Open(OpenPdu {
+                frames_per_packet: 320,
+                initial_format: 0,
+                capture_format: fmt,
+            }),
+        ] {
+            client.process(7, &encode_vec(&pdu).unwrap()).unwrap();
+        }
+        assert_eq!(state.lock().unwrap().status()[..2], [16000, 1]);
+        state.lock().unwrap().submit(&vec![1; 300]);
+        assert!(packets.lock().unwrap().is_empty());
+        state.lock().unwrap().submit(&vec![2; 340]);
+        assert_eq!(packets.lock().unwrap().len(), 2);
+        client.close(7);
+        assert!(state.lock().unwrap().status().is_empty());
+        state.lock().unwrap().submit(&vec![3; 640]);
+        assert_eq!(packets.lock().unwrap().len(), 2);
+    }
+    #[test]
+    fn microphone_rejects_unbounded_or_invalid_capture_and_resets_partial_packet() {
+        let state = Arc::new(Mutex::new(Microphone::default()));
+        let mut b = BrowserMic(state.clone());
+        let f = pcm_format(1, 16000, 16);
+        assert_ne!(b.open(&f, &f, 1000000, Box::new(|_| {})), 0);
+        assert_eq!(b.open(&f, &f, 640, Box::new(|_| {})), 0);
+        state.lock().unwrap().submit(&[1, 2]);
+        let epoch = state.lock().unwrap().epoch;
+        assert!(b.set_format(&f, 640));
+        assert!(state.lock().unwrap().pending.is_empty());
+        assert_ne!(state.lock().unwrap().epoch, epoch);
+        b.close();
+        assert!(state.lock().unwrap().sink.is_none());
+    }
+    #[test]
+    fn camera_negotiates_requests_and_rejects_stale_frames_after_restart() {
+        let shared = CameraRedirectionSession::new();
+        let device = shared
+            .select_device(DeviceDescriptor::new("Browser".into(), "RDCamera_Browser_0".into()).unwrap())
+            .unwrap();
+        let mut enumeration = shared.enumeration_client(vec![device.clone()]).unwrap();
+        enumeration.start(2).unwrap();
+        enumeration
+            .process(
+                2,
+                &encode_vec(&EnumerationPdu::SelectVersionResponse(ProtocolVersion::V2)).unwrap(),
+            )
+            .unwrap();
+        let state = Arc::new(Mutex::new(Camera::default()));
+        let packets = Arc::new(Mutex::new(Vec::new()));
+        let output = packets.clone();
+        let mut client = DeviceClient::new(
+            &device,
+            BrowserCamera(state.clone()),
+            Arc::new(move |_, messages| {
+                output.lock().unwrap().extend(messages);
+                Ok(())
+            }),
+        );
+        client.start(3).unwrap();
+        let mut exchange = |pdu| {
+            let out = client
+                .process(3, &encode_vec(&DeviceMessage::new(ProtocolVersion::V2, pdu)).unwrap())
+                .unwrap();
+            out.first()
+                .map(|p| decode::<DeviceMessage>(&encode_vec(p.as_ref()).unwrap()).unwrap().pdu)
+        };
+        assert_eq!(
+            exchange(DevicePdu::ActivateDeviceRequest),
+            Some(DevicePdu::SuccessResponse)
+        );
+        assert_eq!(
+            exchange(DevicePdu::MediaTypeListRequest(0)),
+            Some(DevicePdu::MediaTypeListResponse(vec![camera_format()]))
+        );
+        let start = || {
+            DevicePdu::StartStreamsRequest(vec![StartStreamInfo {
+                stream_index: 0,
+                media_type: camera_format(),
+            }])
+        };
+        assert_eq!(exchange(start()), Some(DevicePdu::SuccessResponse));
+        assert_eq!(state.lock().unwrap().requested(), 0);
+        exchange(DevicePdu::SampleRequest(0));
+        let epoch = state.lock().unwrap().requested();
+        assert_ne!(epoch, 0);
+        state.lock().unwrap().submit(epoch, vec![0xff, 0xd8, 0xff, 0xd9]);
+        assert_eq!(packets.lock().unwrap().len(), 1);
+        exchange(DevicePdu::StopStreamsRequest);
+        assert_eq!(state.lock().unwrap().requested(), 0);
+        exchange(start());
+        exchange(DevicePdu::SampleRequest(0));
+        state.lock().unwrap().submit(epoch, vec![0xff, 0xd8, 0xff, 0xd9]);
+        assert_eq!(packets.lock().unwrap().len(), 1);
+        let epoch = state.lock().unwrap().requested();
+        state.lock().unwrap().submit(epoch, vec![0xff, 0xd8, 0xff, 0xd9]);
+        assert_eq!(packets.lock().unwrap().len(), 2);
+        client.close(3);
+        assert_eq!(state.lock().unwrap().requested(), 0);
+    }
+}
