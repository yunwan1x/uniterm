@@ -0,0 +1,146 @@
+//! Bound presentation work without dropping any protocol updates.
+use core::pin::Pin;
+use core::task::{Context, Poll};
+use futures_channel::oneshot;
+use ironrdp::pdu::geometry::{InclusiveRectangle, Rectangle as _};
+use wasm_bindgen::{JsCast as _, closure::Closure};
+
+const MAX_REGIONS: usize = 32;
+#[derive(Default)]
+pub(crate) struct Damage {
+    regions: Vec<InclusiveRectangle>,
+}
+fn area(r: &InclusiveRectangle) -> u64 {
+    u64::from(r.width()) * u64::from(r.height())
+}
+impl Damage {
+    pub(crate) fn add(&mut self, mut region: InclusiveRectangle) {
+        // Merge only when the bounding rectangle costs at most 25% extra pixels.
+        // Repeat after each merge: a bridge may join two previously separate regions.
+        let mut i = 0;
+        while i < self.regions.len() {
+            let other = &self.regions[i];
+            let union = region.union(other);
+            if area(&union) * 4 <= (area(&region) + area(other)) * 5 {
+                region = union;
+                self.regions.swap_remove(i);
+                i = 0;
+            } else {
+                i += 1;
+            }
+        }
+        self.regions.push(region);
+        if self.regions.len() > MAX_REGIONS {
+            let mut merged = self.regions[0].clone();
+            for r in &self.regions[1..] {
+                merged = merged.union(r);
+            }
+            self.regions.clear();
+            self.regions.push(merged);
+        }
+    }
+    pub(crate) fn is_empty(&self) -> bool {
+        self.regions.is_empty()
+    }
+    pub(crate) fn take(&mut self) -> Vec<InclusiveRectangle> {
+        core::mem::take(&mut self.regions)
+    }
+    pub(crate) fn clear(&mut self) {
+        self.regions.clear();
+    }
+}
+
+// Own and cancel the RAF callback on resize/disconnect. A paused/hidden tab can
+// keep accumulating bounded damage; protocol processing is never held for RAF.
+pub(crate) struct AnimationFrame {
+    receiver: oneshot::Receiver<()>,
+    window: web_sys::Window,
+    id: i32,
+    _callback: Closure<dyn FnMut(f64)>,
+}
+impl AnimationFrame {
+    pub(crate) fn new() -> anyhow::Result<Self> {
+        let window = web_sys::window().ok_or_else(|| anyhow::anyhow!("window unavailable"))?;
+        let (sender, receiver) = oneshot::channel();
+        let mut sender = Some(sender);
+        let callback = Closure::wrap(Box::new(move |_time: f64| {
+            if let Some(sender) = sender.take() {
+                let _ = sender.send(());
+            }
+        }) as Box<dyn FnMut(f64)>);
+        let id = window
+            .request_animation_frame(callback.as_ref().unchecked_ref())
+            .map_err(|e| anyhow::anyhow!("requestAnimationFrame: {e:?}"))?;
+        Ok(Self {
+            receiver,
+            window,
+            id,
+            _callback: callback,
+        })
+    }
+}
+impl Future for AnimationFrame {
+    type Output = ();
+    fn poll(mut self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<()> {
+        Pin::new(&mut self.receiver).poll(cx).map(|_| ())
+    }
+}
+impl Drop for AnimationFrame {
+    fn drop(&mut self) {
+        let _ = self.window.cancel_animation_frame(self.id);
+    }
+}
+pub(crate) async fn wait_for_frame(frame: &mut Option<AnimationFrame>) {
+    if let Some(frame) = frame {
+        frame.await
+    } else {
+        core::future::pending::<()>().await
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn rect(x: u16, y: u16, w: u16, h: u16) -> InclusiveRectangle {
+        InclusiveRectangle {
+            left: x,
+            top: y,
+            right: x + w - 1,
+            bottom: y + h - 1,
+        }
+    }
+    #[test]
+    fn merges_overlaps_and_adjacent_tiles() {
+        let mut d = Damage::default();
+        d.add(rect(0, 0, 64, 64));
+        d.add(rect(64, 0, 64, 64));
+        d.add(rect(10, 10, 20, 20));
+        assert_eq!(d.take(), vec![rect(0, 0, 128, 64)]);
+        assert!(d.is_empty());
+    }
+    #[test]
+    fn preserves_separated_regions_without_full_screen_union() {
+        let mut d = Damage::default();
+        d.add(rect(0, 0, 5, 5));
+        d.add(rect(1900, 1000, 5, 5));
+        assert_eq!(d.take().len(), 2);
+    }
+    #[test]
+    fn bounds_damage_and_covers_every_input_pixel() {
+        let mut d = Damage::default();
+        let inputs: Vec<_> = (0..100).map(|n| rect((n % 10) * 100, (n / 10) * 100, 2, 2)).collect();
+        for r in &inputs {
+            d.add(r.clone());
+            assert!(d.regions.len() <= MAX_REGIONS)
+        }
+        for r in inputs {
+            assert!(
+                d.regions
+                    .iter()
+                    .any(|m| m.left <= r.left && m.top <= r.top && m.right >= r.right && m.bottom >= r.bottom)
+            )
+        }
+        d.clear();
+        assert!(d.is_empty());
+    }
+}
