+    /// Wrap raw `user_data` in an MCS Send Data Request / X.224 packet.
+    fn encode_raw_send_data_request(
+        &self,
+        initiator_id: u16,
+        channel_id: u16,
+        user_data: Vec<u8>,
+        buf: &mut WriteBuf,
+    ) -> ConnectorResult<usize> {
