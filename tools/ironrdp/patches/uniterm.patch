+/// Starts preparation without borrowing the graphics engine across an await.
+/// The JS queue owns at most the two pictures of one AVC444 command.
+pub(crate) fn prepare(chunks: Vec<(u16, Vec<u8>, bool)>) -> Result<Option<wasm_bindgen_futures::JsFuture>, JsValue> {
+    if chunks.is_empty() { return Ok(None); }
+    let requests = js_sys::Array::new();
+    for (surface, data, yuv) in chunks {
