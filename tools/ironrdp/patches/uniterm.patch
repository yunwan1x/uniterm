index 00000000..2c1ac328
--- /dev/null
+++ b/crates/ironrdp-web/src/audio.rs
@@ -0,0 +1,137 @@
+//! Bounded PCM bridge. JS owns Web Audio; the protocol backend remains Send.
+use crate::session::RdpInputEvent;
+use futures_channel::mpsc;
+use ironrdp::rdpsnd::{
+    client::RdpsndClientHandler,
+    pdu::{AudioFormat, AudioFormatFlags, PitchPdu, VolumePdu, WaveFormat},
+};
+use std::borrow::Cow;
+use std::sync::{
+    Arc,
+    atomic::{AtomicUsize, Ordering},
+};
+
+const MAX_QUEUED_BYTES: usize = 256 * 1024;
+
+#[derive(Debug)]
+pub(crate) struct PcmPacket {
+    pub format: AudioFormat,
+    pub data: Vec<u8>,
+    queued: Arc<AtomicUsize>,
+}
+impl Drop for PcmPacket {
+    fn drop(&mut self) {
+        self.queued.fetch_sub(self.data.len(), Ordering::Relaxed);
+    }
+}
+#[derive(Debug)]
+pub(crate) enum AudioEvent {
+    Pcm(PcmPacket),
+    Volume(u16, u16),
+    Close,
+}
+
+#[derive(Debug)]
+pub(crate) struct WebAudioBackend {
+    tx: mpsc::UnboundedSender<RdpInputEvent>,
+    queued: Arc<AtomicUsize>,
+}
+impl WebAudioBackend {
+    pub fn new(tx: mpsc::UnboundedSender<RdpInputEvent>) -> Self {
+        Self {
+            tx,
+            queued: Arc::new(AtomicUsize::new(0)),
+        }
+    }
+}
+fn supported(f: &AudioFormat) -> bool {
+    f.format == WaveFormat::PCM
+        && matches!(f.n_channels, 1 | 2)
+        && matches!(f.bits_per_sample, 8 | 16)
+        && (8000..=48000).contains(&f.n_samples_per_sec)
+        && f.n_block_align == f.n_channels * (f.bits_per_sample / 8)
+}
+impl RdpsndClientHandler for WebAudioBackend {
+    fn get_flags(&self) -> AudioFormatFlags {
+        AudioFormatFlags::ALIVE | AudioFormatFlags::VOLUME
+    }
+    fn get_formats(&self) -> &[AudioFormat] {
+        &[]
+    }
+    fn choose_formats(&self, formats: &[AudioFormat]) -> Vec<AudioFormat> {
+        formats.iter().filter(|f| supported(f)).cloned().collect()
+    }
+    fn wave(&mut self, format: &AudioFormat, _ts: u32, data: Cow<'_, [u8]>) {
+        if !supported(format) || data.is_empty() || data.len() % usize::from(format.n_block_align) != 0 {
+            return;
+        }
+        if self
+            .queued
+            .fetch_update(Ordering::Relaxed, Ordering::Relaxed, |n| {
+                n.checked_add(data.len()).filter(|v| *v <= MAX_QUEUED_BYTES)
+            })
+            .is_err()
+        {
+            return;
+        }
+        let packet = PcmPacket {
+            format: format.clone(),
+            data: data.into_owned(),
+            queued: self.queued.clone(),
+        };
+        let _ = self.tx.unbounded_send(RdpInputEvent::Audio(AudioEvent::Pcm(packet)));
+    }
+    fn set_volume(&mut self, volume: VolumePdu) {
+        let _ = self.tx.unbounded_send(RdpInputEvent::Audio(AudioEvent::Volume(
+            volume.volume_left,
+            volume.volume_right,
+        )));
+    }
+    fn set_pitch(&mut self, _pitch: PitchPdu) {} // PITCH is deliberately not advertised.
+    fn close(&mut self) {
+        let _ = self.tx.unbounded_send(RdpInputEvent::Audio(AudioEvent::Close));
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use futures_util::StreamExt;
+    fn pcm() -> AudioFormat {
+        AudioFormat {
+            format: WaveFormat::PCM,
+            n_channels: 2,
+            n_samples_per_sec: 44100,
+            n_avg_bytes_per_sec: 176400,
+            n_block_align: 4,
+            bits_per_sample: 16,
+            data: None,
+        }
+    }
+    #[test]
+    fn only_advertise_supported_server_pcm_formats() {
+        let (tx, _) = mpsc::unbounded();
+        let b = WebAudioBackend::new(tx);
+        let mut invalid = pcm();
+        invalid.format = WaveFormat::AAC_MS;
+        let mut misaligned = pcm();
+        misaligned.n_block_align = 1;
+        assert_eq!(b.choose_formats(&[invalid, misaligned, pcm()]), vec![pcm()]);
+        assert!(b.get_flags().contains(AudioFormatFlags::ALIVE));
+        assert!(!b.get_flags().contains(AudioFormatFlags::PITCH));
+    }
+    #[test]
+    fn queue_is_bounded_and_released_when_consumed_or_disconnected() {
+        let (tx, mut rx) = mpsc::unbounded();
+        let mut b = WebAudioBackend::new(tx);
+        b.wave(&pcm(), 0, Cow::Owned(vec![0; MAX_QUEUED_BYTES]));
+        b.wave(&pcm(), 1, Cow::Owned(vec![0; 4]));
+        assert_eq!(b.queued.load(Ordering::Relaxed), MAX_QUEUED_BYTES);
+        drop(rx.next().now_or_never().unwrap());
+        assert_eq!(b.queued.load(Ordering::Relaxed), 0);
+        drop(rx);
+        b.wave(&pcm(), 2, Cow::Owned(vec![0; 4]));
+        assert_eq!(b.queued.load(Ordering::Relaxed), 0);
+    }
+    use futures_util::FutureExt;
+}
