+#[test]
+fn xrdp_reconnect_early_audio_does_not_stop_training() {
+    // oracle: spec MS-RDPEA section 3.1.5; reconnecting an actively playing xrdp desktop must allow subsequent audio.
+    let backend = RecordingBackend::with_formats(vec![pcm(44100, 2)]);
+    let waves = Arc::clone(&backend.waves);
+    let mut client = Rdpsnd::new(Box::new(backend));
+    client.process(&encoded_server_formats(pdu::Version::V8)).unwrap();
+    client.process(&encoded_wave2(0)).unwrap();
+    client.process(&encoded_close()).unwrap();
+    assert!(waves.lock().unwrap().is_empty());
+    let response = decode_single_response(&client.process(&encoded_training()).unwrap());
+    assert!(matches!(response, pdu::ClientAudioOutputPdu::TrainingConfirm(_)));
+    client.process(&encoded_wave2(1)).unwrap();
+    assert_eq!(waves.lock().unwrap().len(), 1);
+}
+
+#[test]
+fn xrdp_early_close_preserves_training() {
+    // oracle: spec MS-RDPEA section 3.1.5; an old stream closing during reconnect must not disable the new stream.
+    let mut client = client_in_waiting();
+    client.process(&encoded_close()).unwrap();
+    let response = decode_single_response(&client.process(&encoded_training()).unwrap());
+    assert!(matches!(response, pdu::ClientAudioOutputPdu::TrainingConfirm(_)));
+    assert_eq!(client.process(&encoded_wave2(1)).unwrap().len(), 1);
+}
