index 00000000..8e530699
--- /dev/null
+++ b/crates/ironrdp-web/src/render_benchmark.rs
@@ -0,0 +1,140 @@
+//! Synthetic framebuffer replay; compiled only for the browser benchmark.
+use crate::{canvas::Canvas, image::extract_region, presentation::Damage};
+use core::num::NonZeroU32;
+use ironrdp::pdu::geometry::{InclusiveRectangle, Rectangle as _};
+use ironrdp_core::WriteBuf;
+use wasm_bindgen::prelude::*;
+
+#[wasm_bindgen]
+pub struct RenderReplay {
+    canvas: Canvas,
+    pixels: Vec<u8>,
+    width: u16,
+    height: u16,
+    baseline: bool,
+    damage: Damage,
+    buffer: WriteBuf,
+    copied_bytes: u64,
+    calls: u32,
+    draw_ms: f64,
+}
+#[wasm_bindgen]
+impl RenderReplay {
+    #[wasm_bindgen(constructor)]
+    pub fn new(
+        canvas: web_sys::HtmlCanvasElement,
+        width: u16,
+        height: u16,
+        baseline: bool,
+    ) -> Result<RenderReplay, JsValue> {
+        let w = NonZeroU32::new(u32::from(width)).ok_or_else(|| JsValue::from_str("width"))?;
+        let h = NonZeroU32::new(u32::from(height)).ok_or_else(|| JsValue::from_str("height"))?;
+        Ok(Self {
+            canvas: Canvas::new(canvas, w, h).map_err(|e| JsValue::from_str(&e.to_string()))?,
+            pixels: vec![0; usize::from(width) * usize::from(height) * 4],
+            width,
+            height,
+            baseline,
+            damage: Damage::default(),
+            buffer: WriteBuf::new(),
+            copied_bytes: 0,
+            calls: 0,
+            draw_ms: 0.0,
+        })
+    }
+    pub fn update(&mut self, x: u16, y: u16, w: u16, h: u16, seed: u32) -> Result<(), JsValue> {
+        if w == 0
+            || h == 0
+            || u32::from(x) + u32::from(w) > u32::from(self.width)
+            || u32::from(y) + u32::from(h) > u32::from(self.height)
+        {
+            return Err(JsValue::from_str("bounds"));
+        }
+        for yy in y..y + h {
+            for xx in x..x + w {
+                let p = (usize::from(yy) * usize::from(self.width) + usize::from(xx)) * 4;
+                self.pixels[p] = (u32::from(xx) * 17 + seed) as u8;
+                self.pixels[p + 1] = (u32::from(yy) * 11 + seed) as u8;
+                self.pixels[p + 2] = seed as u8;
+                self.pixels[p + 3] = 255;
+            }
+        }
+        let mut r = InclusiveRectangle {
+            left: x,
+            top: y,
+            right: x + w - 1,
+            bottom: y + h - 1,
+        };
+        if self.baseline {
+            if r.height() > 64 || r.width() > 512 {
+                r.left = 0;
+                r.right = self.width - 1;
+            }
+            self.draw(r)?;
+        } else {
+            self.damage.add(r);
+        }
+        Ok(())
+    }
+    pub fn flush(&mut self) -> Result<(), JsValue> {
+        for r in self.damage.take() {
+            self.draw(r)?;
+        }
+        Ok(())
+    }
+    pub fn resize(&mut self, width: u16, height: u16) -> Result<(), JsValue> {
+        let w = NonZeroU32::new(u32::from(width)).ok_or_else(|| JsValue::from_str("width"))?;
+        let h = NonZeroU32::new(u32::from(height)).ok_or_else(|| JsValue::from_str("height"))?;
+        self.damage.clear();
+        self.width = width;
+        self.height = height;
+        self.pixels = vec![0; usize::from(width) * usize::from(height) * 4];
+        self.canvas.resize(w, h);
+        Ok(())
+    }
+    pub fn reset_stats(&mut self) {
+        self.copied_bytes = 0;
+        self.calls = 0;
+        self.draw_ms = 0.0;
+    }
+    pub fn draw_time_ms(&self) -> f64 {
+        self.draw_ms
+    }
+    pub fn copied_bytes(&self) -> f64 {
+        self.copied_bytes as f64
+    }
+    pub fn draw_calls(&self) -> u32 {
+        self.calls
+    }
+}
+impl RenderReplay {
+    fn draw(&mut self, r: InclusiveRectangle) -> Result<(), JsValue> {
+        let performance = web_sys::window()
+            .and_then(|w| w.performance())
+            .expect("browser performance");
+        let started = performance.now();
+        let r = extract_region(&self.pixels, self.width, 4, r, &mut self.buffer);
+        self.copied_bytes += self.buffer.filled().len() as u64;
+        self.calls += 1;
+        self.canvas
+            .draw(self.buffer.filled_mut(), r)
+            .map_err(|e| JsValue::from_str(&e.to_string()))?;
+        self.buffer.clear();
+        self.draw_ms += performance.now() - started;
+        Ok(())
+    }
+}
+
+#[wasm_bindgen]
+pub async fn check_frame_clock() -> Result<(), JsValue> {
+    use crate::presentation::{AnimationFrame, wait_for_frame};
+    // Cancel pending callbacks (resize/disconnect) and then wait for an idle
+    // frame. A missing cancel would invoke an already-dropped WASM closure.
+    for _ in 0..16 {
+        let frame = AnimationFrame::new().map_err(|e| JsValue::from_str(&e.to_string()))?;
+        drop(frame);
+    }
+    let mut frame = Some(AnimationFrame::new().map_err(|e| JsValue::from_str(&e.to_string()))?);
+    wait_for_frame(&mut frame).await;
+    Ok(())
+}
