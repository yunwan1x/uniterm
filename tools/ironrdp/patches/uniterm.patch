+// GFX requires 32-bit color. Keep the compatibility path's existing 16-bit
+// preference when the experimental pipeline is disabled.
+fn configure_graphics_pipeline(config: &mut connector::Config, enabled: bool) {
+    config.support_dyn_vc_gfx_protocol = enabled;
+    if enabled {
+        if let Some(bitmap) = config.bitmap.as_mut() {
+            bitmap.color_depth = 32;
+        }
