<!DOCTYPE html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>软件中心 · uniTerm</title><script src="/js/jquery.js"></script><style>
*{box-sizing:border-box}body{margin:0;background:#15212e;color:#e6edf5;font:15px/1.6 system-ui,sans-serif}main{max-width:820px;margin:32px auto;padding:28px;background:#213143;border-radius:12px}h1{margin:0}a{color:#8bd5ff}label{display:block;margin:16px 0 6px}input[type=number],input[type=password],input[type=text],select{width:100%;padding:10px;background:#142334;border:1px solid #607589;border-radius:6px;color:white}button,.button{display:inline-block;margin:16px 8px 0 0;padding:10px 18px;border:0;border-radius:6px;background:#84ccff;color:#102336;text-decoration:none;cursor:pointer}button:disabled{opacity:.5}pre{background:#102030;padding:14px;white-space:pre-wrap;overflow-wrap:anywhere;max-height:300px;overflow:auto}.muted{color:#b1c2d3;font-size:13px}.error{color:#ffaaaa}@media(max-width:600px){main{margin:0;border-radius:0;padding:20px}}
</style></head><body><main><a href="/Module_Softcenter.asp">← 软件中心</a><h1>uniTerm</h1><p class="muted">Web 终端、文件传输与远程连接管理。服务仅监听 LAN 地址，需要单独登录 uniTerm 账号。</p>
<form id="settings"><label><input id="enable" type="checkbox"> 启用服务并开机启动</label><label for="port">访问端口</label><input id="port" type="number" min="1024" max="65535" value="18888" required>
<label><input id="tls" type="checkbox"> 使用 HTTPS 加密访问</label>
<div id="tls-settings"><label for="tls_mode">证书方式</label><select id="tls_mode"><option value="auto">自动生成自签名证书（IP 地址访问）</option><option value="custom">使用已有证书</option></select>
<div id="custom-cert"><label for="tls_cert">证书文件绝对路径（PEM，可包含证书链）</label><input id="tls_cert" type="text" placeholder="/koolshare/configs/uniterm/tls/server.crt"><label for="tls_key">未加密私钥文件绝对路径（PEM）</label><input id="tls_key" type="text" placeholder="/koolshare/configs/uniterm/tls/server.key"></div>
<p class="muted">自签名证书首次访问会出现浏览器提示；信任证书后可正常使用。自有域名证书请使用证书对应域名访问。开启后本端口只提供 HTTPS。</p></div>
<label for="password">首次启动的管理员密码</label><input id="password" type="password" autocomplete="new-password" placeholder="首次启动必填；已有账号则留空"><p class="muted">账号：admin。首次密码为 6–24 字节，初始化后在 uniTerm 内管理账号和密码。密码不会显示在日志中。</p>
<button type="submit">保存并应用</button><button type="button" id="stop">停用</button><button type="button" id="restart">重启</button><a class="button" id="open" href="#" target="_blank" rel="noopener noreferrer">打开 uniTerm</a><p id="message" role="status"></p></form>
<h3>运行状态</h3><button type="button" id="refresh">刷新</button><pre id="status">正在读取…</pre><h3>运行日志</h3><button type="button" id="logs">读取日志</button><pre id="log">点击读取最近日志</pre>
<p class="muted">数据保存在 /koolshare/configs/uniterm/data，卸载时保留。文件传输下载到路由器会占用存储；大文件请使用外接存储。日志存放在 /tmp，每 5 分钟检查轮转。HTTP 局域网访问不提供链路加密；部分需要安全上下文的浏览器功能受限。</p><p class="muted">插件支持 Linux ARM64 KoolCenter 固件。<a href="https://github.com/yunwan1x/uniterm" target="_blank" rel="noopener">项目源码</a></p></main>
<script>
'use strict';let busy=false;
function call(action,fields){return $.ajax({url:'/_api/',type:'POST',contentType:'application/json',dataType:'json',timeout:40000,data:JSON.stringify({id:Math.floor(Math.random()*100000000),method:'uniterm_config.sh',params:[action],fields:fields||{}})}).then(r=>{if(typeof r.result==='number')return '__PENDING__';if(typeof r.result!=='string')throw Error('接口返回异常');return new TextDecoder().decode(Uint8Array.from(atob(r.result),c=>c.charCodeAt(0)))})}
function complete(t,n){if(t.trim()!=='__PENDING__')return $.Deferred().resolve(t).promise();if(n>45)return $.Deferred().reject().promise();return $.Deferred(d=>setTimeout(()=>call('result').then(r=>complete(r,n+1)).then(d.resolve,d.reject),1000)).promise()}
function message(t,error){$('#message').text(t).toggleClass('error',!!error)}
function link(){const p=Number($('#port').val());$('#open').attr('href',p>=1024&&p<=65535?($('#tls').prop('checked')?'https://':'http://')+location.hostname+':'+p+'/':'#')}
function tlsFields(){const on=$('#tls').prop('checked');$('#tls-settings').toggle(on);$('#custom-cert').toggle($('#tls_mode').val()==='custom');link()}
function refresh(){return call('status').then(t=>$('#status').text(t))}
function run(a,f){if(busy)return;busy=true;$('button').prop('disabled',true);message('正在执行…');call(a,f).then(t=>complete(t,0)).then(t=>{message(t,t.startsWith('操作失败'));$('#password').val('');link();return refresh()}).fail(()=>message('操作未确认，请刷新状态查看。',true)).always(()=>{busy=false;$('button').prop('disabled',false)})}
$('#settings').on('submit',e=>{e.preventDefault();const f={uniterm_enable:$('#enable').prop('checked')?'1':'0',uniterm_port:String($('#port').val()),uniterm_tls:$('#tls').prop('checked')?'1':'0',uniterm_tls_mode:$('#tls_mode').val(),uniterm_tls_cert:$('#tls_cert').val(),uniterm_tls_key:$('#tls_key').val()};if($('#password').val())f.uniterm_initial_password=$('#password').val();run('apply',f)});
$('#port').on('input',link);$('#tls,#tls_mode').on('change',tlsFields);$('#stop').on('click',()=>{$('#enable').prop('checked',false);run('apply',{uniterm_enable:'0'})});$('#restart').on('click',()=>run('restart'));$('#refresh').on('click',()=>refresh().fail(()=>message('读取状态失败',true)));$('#logs').on('click',()=>call('log').then(t=>$('#log').text(t)).fail(()=>message('日志读取失败',true)));
$.getJSON('/_api/uniterm_').then(r=>{const c=r.result[0]||{};$('#enable').prop('checked',c.uniterm_enable==='1');$('#port').val(c.uniterm_port||18888);$('#tls').prop('checked',c.uniterm_tls==='1');$('#tls_mode').val(c.uniterm_tls_mode||'auto');$('#tls_cert').val(c.uniterm_tls_cert||'');$('#tls_key').val(c.uniterm_tls_key||'');tlsFields();return refresh()}).fail(()=>message('请先通过路由器管理页面登录。',true));
</script></body></html>
